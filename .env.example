# app
NEXT_PUBLIC_APP_URL = "http://localhost:3000"
NEXT_PUBLIC_APP_NAME = "Happy Horse AI"

# theme
NEXT_PUBLIC_THEME = "default"

# appearance
NEXT_PUBLIC_APPEARANCE = "system"

# database
DATABASE_PROVIDER = "sqlite"
DATABASE_URL = "file:data/local.db"
DB_SCHEMA_FILE = "./src/config/db/schema.sqlite.ts"
DB_MIGRATIONS_OUT = "./src/config/db/migrations_sqlite"
DB_SINGLETON_ENABLED = "true"
DB_MAX_CONNECTIONS = "1"

# auth secret
# openssl rand -base64 32
AUTH_SECRET = ""

# affiliate
AFFONSO_ENABLED = "false"
AFFONSO_ID = ""
AFFONSO_COOKIE_DURATION = "30"

# Creem prompt moderation for AI generation
CREEM_MODERATION_ENABLED = "false"
CREEM_MODERATION_API_BASE = "https://api.creem.io"
CREEM_MODERATION_API_KEY = ""
CREEM_MODERATION_BLOCK_FLAG = "true"
CREEM_MODERATION_TIMEOUT_MS = "5000"

# APIMart / HappyHorse 1.0 video model
APIMART_API_KEY = ""
APIMART_BASE_URL = "https://api.apimart.ai/v1"
APIMART_CUSTOM_STORAGE = "true"
HAPPYHORSE_720P_CREDITS_PER_SECOND = "20"
HAPPYHORSE_1080P_CREDITS_PER_SECOND = "25"
NEXT_PUBLIC_HAPPYHORSE_720P_CREDITS_PER_SECOND = "20"
NEXT_PUBLIC_HAPPYHORSE_1080P_CREDITS_PER_SECOND = "25"
