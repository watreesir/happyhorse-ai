{
  "buildCommand": "pnpm build",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": "nextjs",
  "build": {
    "env": {
      "NODE_OPTIONS": "--max-old-space-size=4096",
      "NEXT_TELEMETRY_DISABLED": "1"
    }
  },
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 30
    },
    "src/app/api/ai/**/*.ts": {
      "maxDuration": 60
    },
    "src/app/api/payment/**/*.ts": {
      "maxDuration": 30
    },
    "src/app/api/storage/**/*.ts": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/:locale/blog/what-is-happy-horse-ai",
      "destination": "/:locale/blog/happyhorse-ai-1-0",
      "permanent": true
    },
    {
      "source": "/blog/what-is-happy-horse-ai",
      "destination": "/blog/happyhorse-ai-1-0",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/internal/cron/subscription-monthly-credits",
      "schedule": "0 * * * *"
    }
  ]
}
